<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | Hard Court Marketing</title>
    <meta name="description" content="{{ description }}">
    
    <!-- Open Graph -->
    <meta property="og:title" content="{{ title }} | Hard Court Marketing">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://hardcourtmarketing.com{{ page.url }}">
    <meta property="og:image" content="https://hardcourtmarketing.com/logo-full.png">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }} | Hard Court Marketing">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="https://hardcourtmarketing.com/logo-full.png">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo-wordmark.png">
    
    <!-- Fonts: Switzer (Fontshare) + Syne (Google) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://api.fontshare.com/v2/css?f[]=switzer@300,400,500,600,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800;900&family=Young+Serif&display=swap" rel="stylesheet">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/main.css">
    
    <!-- Organization Schema -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Hard Court Marketing",
        "url": "https://hardcourtmarketing.com",
        "logo": "https://hardcourtmarketing.com/logo-full.png",
        "description": "AI-powered marketing for tennis, pickleball, and basketball court contractors.",
        "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+1-801-787-5294",
            "contactType": "Customer Service",
            "email": "info@hardcourtmarketing.com",
            "availableLanguage": "en"
        },
        "address": {
            "@type": "PostalAddress",
            "addressCountry": "US"
        },
        "sameAs": []
    }
    </script>
    
    {% if breadcrumbs %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://hardcourtmarketing.com/"
            }{% for crumb in breadcrumbs %},
            {
                "@type": "ListItem",
                "position": {{ loop.index + 1 }},
                "name": "{{ crumb.name }}",
                "item": "https://hardcourtmarketing.com{{ crumb.url }}"
            }{% endfor %}
        ]
    }
    </script>
    {% endif %}
    
    {% if schema.faq %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {% for faq in schema.faq %}
            {
                "@type": "Question",
                "name": "{{ faq.question }}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{{ faq.answer }}"
                }
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    }
    </script>
    {% endif %}
</head>
<body>
    <div class="progress-bar" id="progress-bar"></div>
    
    <header>
        <nav>
            <a href="/" class="logo-link">
                <img src="/logo-wordmark.png" alt="Hard Court Marketing" class="logo">
            </a>
            
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/portfolio">Work</a></li>
                <li><a href="/about">About</a></li>
            </ul>
            
            <a href="/contact" class="cta-button cta-nav">Book a Call</a>
            
            <button class="mobile-menu-toggle" aria-label="Menu">Menu</button>
        </nav>
    </header>
    
    <main>
        {{ content | safe }}
    </main>
    
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <img src="/logo-full.png" alt="Hard Court Marketing" class="footer-logo">
                    <p>AI-powered marketing for sports surface contractors. Get more qualified leads and higher-value projects.</p>
                </div>
                
                <div class="footer-links-section">
                    <h4>Company</h4>
                    <ul class="footer-links">
                        <li><a href="/about">About</a></li>
                        <li><a href="/portfolio">Work</a></li>
                        <li><a href="/pricing">Pricing</a></li>
                        <li><a href="/contact">Contact</a></li>
                        <li><a href="/faq">FAQ</a></li>
                    </ul>
                </div>
                
                <div class="footer-links-section">
                    <h4>Industries</h4>
                    <ul class="footer-links">
                        <li><a href="/industries/court-installers">Court Installers</a></li>
                        <li><a href="/industries/surface-manufacturers">Surface Manufacturers</a></li>
                        <li><a href="/industries/turf-companies">Turf Companies</a></li>
                        <li><a href="/industries/installation-companies">Installation Companies</a></li>
                        <li><a href="/industries/pickleball-equipment">Pickleball Equipment</a></li>
                        <li><a href="/industries/tennis-equipment">Tennis Equipment</a></li>
                        <li><a href="/industries/basketball-equipment">Basketball Equipment</a></li>
                        <li><a href="/industries/lighting-manufacturers">Lighting</a></li>
                    </ul>
                </div>
                
                <div class="footer-contact">
                    <h4>Get in Touch</h4>
                    <p><a href="tel:+18017875294">(801) 787-5294</a></p>
                    <p>info@hardcourtmarketing.com</p>
                    <ul class="footer-links">
                        <li><a href="/sitemap.xml">Sitemap</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="footer-bottom">
                <p>&copy; 2026 Hard Court Marketing. All rights reserved.</p>
                <p class="powered-by"><a href="https://gullstack.com" target="_blank" class="gullstack-footer-link"><img src="/assets/images/gullstack-bird.png" alt="GullStack" class="gullstack-bird-logo"><span class="gullstack-wordmark">GullStack</span></a></p>
            </div>
        </div>
    </footer>
    
    <script src="/assets/js/main.js"></script>
</body>
</html>