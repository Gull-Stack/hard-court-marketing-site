description: "Get your free marketing audit. We analyze your website, SEO, and competitive position to identify how to increase commercial bookings. 24-hour response guaranteed."
breadcrumbs:
  - name: "Contact"
    url: "/contact"
---

<!-- Hero -->
<section class="section-reveal" style="padding-top: 160px;">
    <div class="container">
        <div class="section-label fade-in-up">Contact</div>
        <h1 class="reveal-heading reveal-text" style="max-width: 500px;">Book a Call</h1>
        <p class="fade-in-up" style="font-size: 1rem; color: rgba(255,255,255,0.5); max-width: 440px; margin-top: 24px; line-height: 1.7;">We respond within 24 hours. Tell us about your business and we will put together a free marketing audit and custom growth plan.</p>
    </div>
</section>

<!-- Form -->
<section style="padding: 60px 0 120px;">
    <div class="container">
        <div style="max-width: 560px;">
            <form action="#" method="post">
                <div class="form-group fade-in-up">
                    <label for="name">Name</label>
                    <input type="text" id="name" name="name" required>
                </div>

                <div class="form-group fade-in-up">
                    <label for="company">Company</label>
                    <input type="text" id="company" name="company" required>
                </div>

                <div class="form-group fade-in-up">
                    <label for="phone">Phone</label>
                    <input type="tel" id="phone" name="phone" required>
                </div>

                <div class="form-group fade-in-up">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required>
                </div>

                <div class="form-group fade-in-up">
                    <label for="services">Primary Service</label>
                    <select id="services" name="services">
                        <option value="">Select your primary service</option>
                        <option value="court-installation">Court Installation</option>
                        <option value="surface-manufacturing">Surface Manufacturing</option>
                        <option value="equipment-manufacturing">Equipment Manufacturing</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <div class="form-group fade-in-up">
                    <label for="revenue">Current Monthly Revenue (optional)</label>
                    <select id="revenue" name="revenue">
                        <option value="">Select range</option>
                        <option value="under-25k">Under $25K</option>
                        <option value="25k-50k">$25K - $50K</option>
                        <option value="50k-100k">$50K - $100K</option>
                        <option value="100k-250k">$100K - $250K</option>
                        <option value="250k-500k">$250K - $500K</option>
                        <option value="500k-plus">$500K+</option>
                    </select>
                </div>

                <div class="form-group fade-in-up">
                    <label for="challenge">Biggest Marketing Challenge</label>
                    <textarea id="challenge" name="challenge" rows="4" required placeholder="Tell us about your biggest marketing challenge..."></textarea>
                </div>

                <div class="form-group fade-in-up">
                    <label for="referral">How Did You Hear About Us?</label>
                    <select id="referral" name="referral">
                        <option value="">Select an option</option>
                        <option value="google-search">Google Search</option>
                        <option value="referral">Referral</option>
                        <option value="social-media">Social Media</option>
                        <option value="industry-event">Industry Event</option>
                        <option value="email-marketing">Email Marketing</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <button type="submit" class="cta-button fade-in-up" style="width: 100%; padding: 14px 28px;">Get My Free Marketing Audit</button>
            </form>
        </div>
    </div>
</section>

<!-- Contact Info -->
<section style="padding: 80px 0 120px;">
    <div class="container">
        <div class="services-list" style="max-width: 560px;">
            <div class="service-item fade-in-up">
                <h3>Email</h3>
                <p><a href="mailto:info@hardcourtmarketing.com" style="color: rgba(255,255,255,0.5);">info@hardcourtmarketing.com</a></p>
            </div>
            <div class="service-item fade-in-up">
                <h3>Hours</h3>
                <p>Monday - Friday: 8:00 AM - 6:00 PM MST<br>Saturday: 9:00 AM - 3:00 PM MST</p>
            </div>
            <div class="service-item fade-in-up">
                <h3>Response Time</h3>
                <p>We respond to every inquiry within 24 hours. Your free marketing audit and consultation will be scheduled within one business day.</p>
            </div>
        </div>
    </div>
</section>

<!-- Final CTA -->
<section class="section-final-cta">
    <div class="container">
        <div class="text-center">
            <h2 class="final-cta-heading reveal-text">Let's Talk</h2>
            <p class="final-cta-sub fade-in-up">Join the growing network of court contractors who dominate their local markets.</p>
            <a href="mailto:info@hardcourtmarketing.com" class="cta-button fade-in-up">Email Us Directly</a>
        </div>
    </div>
</section>
